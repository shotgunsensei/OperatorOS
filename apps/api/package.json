{
  "name": "@operatoros/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --dir ../../packages/sdk build && tsc",
    "start": "node --conditions=production dist/apps/api/src/index.js",
    "typecheck": "tsc --noEmit",
    "security:rotate-seed-credentials": "tsx src/scripts/rotate-seed-credentials.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts test/*.test.tsx"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@operatoros/sdk": "workspace:*",
    "fastify": "^5.10.0",
    "pg": "^8.16.3",
    "pino-pretty": "^13.0.0",
    "qrcode": "1.5.4",
    "stripe": "^20.4.1",
    "twilio": "^5.10.4"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/qrcode": "1.5.5",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3"
  }
}
