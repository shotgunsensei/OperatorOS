{
  "name": "@operatoros/torqueshed-native",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "validate:config": "tsx scripts/validate-config.ts",
    "validate:release": "tsx scripts/validate-release.ts",
    "export:mobile": "expo export --platform android --platform ios --output-dir dist",
    "prebuild": "expo prebuild --no-install --clean",
    "prebuild:android": "expo prebuild --platform android --no-install --clean",
    "prebuild:ios": "expo prebuild --platform ios --no-install --clean",
    "smoke:harness": "tsx scripts/verify-device-harness.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "~15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-image-picker": "~57.0.9",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.2.2",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3"
  }
}
