{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operatoros.net/schemas/module-registry-v1.json",
  "title": "OperatorOS module registry v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["moduleId", "slug", "displayName", "clientId", "entitlementKey", "productionBaseUrl", "exactRedirectUris", "exactLogoutUris", "exactAllowedOrigins", "callbackPath", "launchPath", "healthCheckPath", "enabled", "environment", "contractVersion", "minimumAuthAdapterVersion"],
    "properties": {
      "moduleId": { "type": "string", "minLength": 1 },
      "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "displayName": { "type": "string", "minLength": 1 },
      "clientId": { "type": "string", "pattern": "^operatoros:[a-z0-9-]+$" },
      "entitlementKey": { "type": "string", "minLength": 1 },
      "productionBaseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
      "stagingBaseUrl": { "type": ["string", "null"], "format": "uri" },
      "exactRedirectUris": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
      "exactLogoutUris": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
      "exactAllowedOrigins": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
      "callbackPath": { "type": "string", "pattern": "^/" },
      "launchPath": { "type": "string", "pattern": "^/" },
      "healthCheckPath": { "type": "string", "pattern": "^/" },
      "enabled": { "type": "boolean" },
      "environment": { "enum": ["development", "preview", "staging", "production"] },
      "contractVersion": { "const": "v1" },
      "minimumAuthAdapterVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
      "icon": { "type": ["string", "null"] },
      "owner": { "type": ["string", "null"] }
    }
  }
}
