# =============================================================================
# OperatorOS Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in values. On Replit, set the same keys via
# the Secrets pane instead of committing them to disk.
#
# Legend:
#   [REQUIRED]  must be set for the app to boot
#   [OPTIONAL]  app boots without it; the related feature is disabled and a
#               warning is logged at startup
# =============================================================================


# ---- Core (required) -------------------------------------------------------

# [REQUIRED] PostgreSQL connection string. Used by both the API and migrations.
DATABASE_URL=postgresql://user:pass@localhost:5432/operatoros

# [OPTIONAL] Bounded PostgreSQL pool controls. Invalid or out-of-range values
# fail startup. Defaults: 10 connections, 30s idle, 10s connect timeout.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

# [REQUIRED] Secret used to sign JWT auth tokens AND Fastify cookies. Must be a
# long random string in production. Rotating this value invalidates every
# active session and password-reset token.
SESSION_SECRET=change-me-in-production


# ---- Service ports ---------------------------------------------------------

# [REQUIRED IN THE UNIFIED PRODUCTION RUNTIME] Public Next port and private
# Fastify port. The supervisor rejects equal values.
PORT=5000
API_PORT=5001

# [OPTIONAL] Runner gateway port (only when run as a separate service).
GATEWAY_PORT=5002

# [OPTIONAL] How the API reaches the runner gateway.
GATEWAY_URL=http://localhost:5002


# ---- Frontend (Next.js) ---------------------------------------------------

# [REQUIRED FOR PRODUCTION WEB BUILDS] Server-only Fastify origin used by
# Next.js rewrites and server-side requests. Keep the browser on same-origin
# /api/* so module cookies remain host-scoped.
INTERNAL_API_URL=http://localhost:5001

# [OPTIONAL] Public API origin for Capacitor/mobile builds or a deliberately
# split deployment. The shared Replit web runtime should use INTERNAL_API_URL.
NEXT_PUBLIC_API_URL=


# ---- Runner / CDE ---------------------------------------------------------

# [OPTIONAL] Runner mode: `docker` (requires Docker CLI) or `k8s` (requires
# k3d/kubectl). The CDE shell features will be disabled if neither is usable.
RUNNER_MODE=docker

# [OPTIONAL] Workspace volume mount base for docker mode.
WORKSPACE_VOLUME_BASE=/tmp/operatoros-workspaces

# [OPTIONAL] Set to `true` to bypass the CDE command denylist (curl, wget,
# sudo, etc.). DO NOT enable in production.
ALLOW_UNSAFE_COMMANDS=false


# ---- Bootstrap & seeding --------------------------------------------------

# [OPTIONAL] Email of the user who should be promoted to platform `super_admin`
# on every boot. Useful for re-asserting admin after a DB reset. The user must
# already exist (or be created by the explicit admin seed below).
OPERATOROS_BOOTSTRAP_SUPER_ADMIN_EMAIL=

# [REQUIRED IN PRODUCTION ONLY WHEN THE ADMIN ROW DOES NOT EXIST] Store in the
# deployment secret manager. There is deliberately no source-code fallback.
ADMIN_EMAIL=john@shotgunninjas.com
ADMIN_NAME=OperatorOS Admin
ADMIN_PASSWORD=

# [OPTIONAL] Demo account creation is skipped unless an explicit secret is set.
DEMO_EMAIL=demo@operatoros.com
DEMO_PASSWORD=


# ---- AI provider (optional) ----------------------------------------------

# [OPTIONAL] OpenAI key for the AI Assistant + agent loop. If unset, the AI
# module may expose explicitly non-production fallback behavior. Mock output
# never satisfies production provider or workflow acceptance.
OPENAI_API_KEY=


# ---- Unified OperatorOS browser SSO ---------------------------------------

# [REQUIRED IN PRODUCTION] Hub-only AES-GCM key for short-lived browser
# authorization codes. Never expose this value to the web bundle or a module.
SSO_CODE_ENCRYPTION_SECRET=

# [REQUIRED ON REPLIT] Trust X-Forwarded-Host/Proto only when the API is behind
# Replit's managed proxy. This is required for exact callback-host validation.
TRUST_PROXY=true

# [REQUIRED IN PRODUCTION] Canonical OperatorOS issuer/control-plane base.
# This is the only supported production platform URL override. Leave the
# legacy APP_URL input unset in production. The operator-os.replit.app alias
# is not a callback, CORS origin, logout URI, or absolute auth return target.
OPERATOROS_BASE_URL=https://operatoros.net

# [REQUIRED IN PRODUCTION] Canonical authenticated application launcher.
# Child modules receive this through the navigation contract and must not
# hard-code /app on their own subdomain.
OPERATOROS_APPS_URL=https://app.operatoros.net/

# [REQUIRED IN PRODUCTION] Exact environment names prevent SSO and database
# release drift.
APP_ENV=production
NODE_ENV=production

# [REQUIRED IN PRODUCTION] Authorizes only the reviewed idempotent release.
# OPERATOROS_DATABASE_RELEASE_APPLIED is supervisor-owned and must never be
# configured in the deployment secret/environment set.
OPERATOROS_DATABASE_RELEASE_MODE=apply

# [TRANSITIONAL] Legacy HS256/HMAC rollback key. Production SSO v1 never uses
# this as its code-sealing key. Do not distribute it to unified-runtime
# modules; remove it after the rollback window.
MODULE_SSO_SECRET=

# [OPTIONAL, EMERGENCY ROLLBACK ONLY] Production leaves legacy raw-JTI/JWT
# consume routes unmounted. Set true only for a time-boxed rollback, then
# remove it. The canonical browser lane never requires this setting.
ALLOW_LEGACY_SSO_ROLLBACK=false


# ---- Module URLs (optional, one per Shotgun module) -----------------------
# Development may omit a module URL. Production values must remain the exact
# registered *.operatoros.net hosts below; never substitute a retired
# standalone product domain.
# When an enabled module URL is missing, its "Open App" CTA is hidden and the
# module is shown as `coming_soon`. OutCall is active at its canonical host;
# live provider operations remain separately gated by the documented protection
# keys, Twilio configuration, callback origin, and activation switch.

TRADEFLOWKIT_URL=https://tradeflowkit.operatoros.net
OUTCALL_URL=https://outcall.operatoros.net
TORQUESHED_URL=https://torqueshed.operatoros.net
TECHDECK_URL=https://techdeck.operatoros.net
PULSEDESK_URL=https://pulsedesk.operatoros.net
FAULTLINELAB_URL=https://faultlinelab.operatoros.net
NINJA_POOL_HALL_URL=https://ninja-pool-hall.operatoros.net
BRANDFORGEOS_URL=https://brandforgeos.operatoros.net
SNAPPROOFOS_URL=https://snapproofos.operatoros.net
STUDYFORGE_AI_URL=https://studyforge-ai.operatoros.net
NINJA_LAUNCH_KIT_URL=https://ninjalaunchkit.operatoros.net
CALLCOMMAND_AI_URL=https://callcommand-ai.operatoros.net
NINJAMATION_URL=https://ninjamation.operatoros.net


# ---- Stripe billing (optional) -------------------------------------------
# Stripe stays disabled until BOTH a secret key is set AND STRIPE_MODE=live.
# When disabled: billing pages still render, checkout buttons show a
# "configuration needed" state, webhooks return 503. The app never crashes.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One canonical endpoint owns plans, add-ons, and Torque Assist credits. Stripe
# signing secrets are endpoint-specific; do not configure the retired
# /v1/billing/torque-assist/webhook URL with this secret.
STRIPE_WEBHOOK_ENDPOINT_URL=https://api.operatoros.net/v1/billing/webhook
STRIPE_WEBHOOK_EVENTS=checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired,payment_intent.payment_failed,charge.refunded,charge.dispute.created,charge.dispute.closed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_succeeded,invoice.payment_failed
STRIPE_EXPECTED_ACCOUNT_ID=

# `live` enables real Stripe calls. `test` keeps the SDK guard tripped so no
# checkout sessions are created (safe default for staging).
STRIPE_MODE=test

# [OPTIONAL] Tenant-owned TradeFlowKit business payments. These do not grant
# OperatorOS subscriptions or entitlements. Leave the provider unset to fail
# closed. Test/live mode must match STRIPE_SECRET_KEY and the connected account.
TRADEFLOWKIT_PAYMENT_PROVIDER=
STRIPE_CLIENT_ID=
TRADEFLOWKIT_STRIPE_CONNECT_WEBHOOK_SECRET=
TRADEFLOWKIT_STRIPE_CONNECT_REDIRECT_URI=https://tradeflowkit.operatoros.net/v1/modules/tradeflowkit/payments/connect/callback
TRADEFLOWKIT_PUBLIC_BASE_URL=https://tradeflowkit.operatoros.net

# [OPTIONAL] 32+ byte server-only key for hashing public-intake client buckets
# and deriving per-tenant adapter signing secrets. Raw client IPs are not stored.
TRADEFLOWKIT_PUBLIC_INTAKE_HMAC_SECRET=

# Finalized monthly product prices. Keep live Stripe IDs in deployment
# secrets; never commit them.
STRIPE_PRICE_TRADEFLOWKIT_MONTHLY=
STRIPE_PRICE_PULSEDESK_MONTHLY=
STRIPE_PRICE_TECHDECK_MONTHLY=
STRIPE_PRICE_COMPANION_MODULE_MONTHLY=
STRIPE_PRICE_ADDITIONAL_SEAT_MONTHLY=

# Display/config fallback in USD cents. Defaults to 1500 ($15).
ADDITIONAL_SEAT_PRICE_CENTS=1500


# [OPTIONAL] Comma-separated list of additional exact origins allowed by CORS.
# Canonical OperatorOS platform/module origins are registered automatically.
# Include scheme and host; wildcard entries are not supported.
CORS_ALLOWED_ORIGINS=

# Deprecated: SSO v1 sessions are deliberately host-only. Do not set a parent
# cookie domain.
# COOKIE_DOMAIN=
