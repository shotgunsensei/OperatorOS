    "test": "pnpm test:unit && pnpm test:api && pnpm test:integration",
    "test:unit": "node scripts/parity/run-unit-tests.mjs",
    "test:api": "node scripts/parity/run-api-tests.mjs",
    "test:integration": "node scripts/parity/run-integration-tests.mjs",
