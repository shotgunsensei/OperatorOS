{
  "contractVersion": 1,
  "deploymentTarget": "replit-autoscale",
  "core": {
    "required": [
      "DATABASE_URL",
      "SESSION_SECRET",
      "SSO_CODE_ENCRYPTION_SECRET",
      "SHARED_SECRET_ENCRYPTION_KEY"
    ],
    "minimumLengths": {
      "SESSION_SECRET": 24,
      "SSO_CODE_ENCRYPTION_SECRET": 32,
      "SHARED_SECRET_ENCRYPTION_KEY": 43
    },
    "exact": {
      "APP_ENV": "production",
      "NODE_ENV": "production",
      "OPERATOROS_BASE_URL": "https://operatoros.net",
      "OPERATOROS_APPS_URL": "https://app.operatoros.net/",
      "INTERNAL_API_URL": "http://localhost:5001",
      "OPERATOROS_DATABASE_RELEASE_MODE": "apply",
      "RUNNER_MODE": "disabled"
    },
    "unset": [
      "APP_URL",
      "COOKIE_DOMAIN",
      "NEXT_PUBLIC_API_URL"
    ],
    "internalOnly": [
      "OPERATOROS_DATABASE_RELEASE_APPLIED"
    ],
    "falseOrUnset": [
      "ALLOW_LEGACY_SSO_ROLLBACK",
      "ALLOW_UNSAFE_COMMANDS"
    ]
  },
  "callcommand": {
    "required": [
      "OPENAI_API_KEY",
      "OPENAI_PROJECT_ID",
      "OPENAI_WEBHOOK_SECRET",
      "CALLCOMMAND_SIP_ROUTE_SECRET",
      "CALLCOMMAND_REALTIME_MODEL",
      "TWILIO_VERIFY_SERVICE_SID",
      "STRIPE_PRICE_CALLCOMMAND_CONCURRENT_LANE_MONTHLY",
      "STRIPE_PRICE_CALLCOMMAND_ADDITIONAL_LOCAL_NUMBER_MONTHLY",
      "STRIPE_PRICE_CALLCOMMAND_TOLL_FREE_NUMBER_MONTHLY"
    ],
    "minimumLengths": {
      "CALLCOMMAND_SIP_ROUTE_SECRET": 32
    },
    "exact": {
      "TWILIO_PUBLIC_BASE_URL": "https://callcommand-ai.operatoros.net"
    },
    "patterns": {
      "OPENAI_PROJECT_ID": {
        "source": "^proj_[A-Za-z0-9_-]+$",
        "message": "must be an OpenAI project ID beginning with proj_"
      },
      "OPENAI_WEBHOOK_SECRET": {
        "source": "^whsec_[A-Za-z0-9_-]+$",
        "message": "must be an OpenAI webhook signing secret beginning with whsec_"
      },
      "TWILIO_VERIFY_SERVICE_SID": {
        "source": "^VA[A-Za-z0-9]+$",
        "message": "must be a Twilio Verify Service SID"
      },
      "STRIPE_PRICE_CALLCOMMAND_CONCURRENT_LANE_MONTHLY": {
        "source": "^price_[A-Za-z0-9_-]+$",
        "message": "must be a Stripe Price ID"
      },
      "STRIPE_PRICE_CALLCOMMAND_ADDITIONAL_LOCAL_NUMBER_MONTHLY": {
        "source": "^price_[A-Za-z0-9_-]+$",
        "message": "must be a Stripe Price ID"
      },
      "STRIPE_PRICE_CALLCOMMAND_TOLL_FREE_NUMBER_MONTHLY": {
        "source": "^price_[A-Za-z0-9_-]+$",
        "message": "must be a Stripe Price ID"
      }
    },
    "allowedValues": {
      "CALLCOMMAND_REALTIME_MODEL": [
        "gpt-realtime-2.1-mini",
        "gpt-realtime-2.1"
      ]
    }
  },
  "canonicalModuleUrls": {
    "TRADEFLOWKIT_URL": "https://tradeflowkit.operatoros.net",
    "TORQUESHED_URL": "https://torqueshed.operatoros.net",
    "TECHDECK_URL": "https://techdeck.operatoros.net",
    "PULSEDESK_URL": "https://pulsedesk.operatoros.net",
    "FAULTLINELAB_URL": "https://faultlinelab.operatoros.net",
    "OPERATOR_POOL_HALL_URL": "https://operatorpoolhall.operatoros.net",
    "NINJA_POOL_HALL_URL": "https://operatorpoolhall.operatoros.net",
    "BRANDFORGEOS_URL": "https://brandforgeos.operatoros.net",
    "SNAPPROOFOS_URL": "https://snapproofos.operatoros.net",
    "STUDYFORGE_AI_URL": "https://studyforge-ai.operatoros.net",
    "DEPLOY_OPS_URL": "https://deployops.operatoros.net",
    "NINJA_LAUNCH_KIT_URL": "https://deployops.operatoros.net",
    "CALLCOMMAND_AI_URL": "https://callcommand-ai.operatoros.net",
    "SCRIPT_OPS_URL": "https://scriptops.operatoros.net",
    "NINJAMATION_URL": "https://scriptops.operatoros.net",
    "OUTCALL_URL": "https://outcall.operatoros.net"
  },
  "cors": {
    "variable": "CORS_ALLOWED_ORIGINS",
    "scheme": "https",
    "wildcards": false,
    "credentialsInUrl": false,
    "loopback": false
  }
}
