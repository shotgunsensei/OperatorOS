    "db:apply": "tsx apps/api/src/scripts/database-release.ts --apply",
    "export:tradeflowkit:snapshot": "tsx apps/api/src/scripts/tradeflowkit-export.ts --read-only",
    "import:tradeflowkit:dry-run": "tsx apps/api/src/scripts/tradeflowkit-import.ts --dry-run",
    "import:tradeflowkit:apply": "tsx apps/api/src/scripts/tradeflowkit-import.ts --apply",
    "import:techdeck:dry-run": "tsx apps/api/src/scripts/techdeck-import.ts --dry-run",
    "import:pulsedesk:dry-run": "tsx apps/api/src/scripts/pulsedesk-import.ts --dry-run",
    "import:torqueshed:dry-run": "tsx apps/api/src/scripts/torqueshed-import.ts --dry-run",
    "import:faultlinelab:dry-run": "tsx apps/api/src/scripts/faultlinelab-import.ts --dry-run",
    "import:ninja-pool-hall:dry-run": "tsx apps/api/src/scripts/ninja-pool-hall-import.ts --dry-run",
    "import:brandforgeos:dry-run": "tsx apps/api/src/scripts/brandforgeos-import.ts --dry-run",
    "import:snapproofos:dry-run": "tsx apps/api/src/scripts/snapproofos-import.ts --dry-run",
    "import:studyforge:dry-run": "tsx apps/api/src/scripts/studyforge-import.ts --dry-run",
    "import:ninja-launch-kit:dry-run": "tsx apps/api/src/scripts/ninja-launch-kit-import.ts --dry-run",
    "import:callcommand:dry-run": "tsx apps/api/src/scripts/callcommand-import.ts --dry-run",
    "import:ninjamation:dry-run": "tsx apps/api/src/scripts/ninjamation-import.ts --dry-run",
    "import:outcall:dry-run": "tsx apps/api/src/scripts/outcall-import.ts --dry-run",
    "migration:rehearse": "tsx apps/api/src/scripts/migration-program.ts --dry-run",
    "load:phase14": "node scripts/phase14-load-baseline.mjs",
    "dev": "pnpm -r --parallel --filter ./apps/api --filter ./apps/runner-gateway --filter ./apps/web dev",
    "dev:api": "pnpm --dir apps/api dev",
    "dev:runner": "pnpm --dir apps/runner-gateway dev",
    "dev:web": "pnpm --dir apps/web dev",
    "build": "pnpm -r --filter ./apps/api --filter ./apps/runner-gateway --filter ./apps/web build",
    "build:production": "pnpm verify:faultlinelab:catalog && node scripts/generate-release-metadata.mjs && pnpm typecheck && pnpm build",
    "start": "pnpm -r --parallel --filter ./apps/api --filter ./apps/runner-gateway --filter ./apps/web start",
    "typecheck": "pnpm -r --filter ./apps/api --filter ./apps/runner-gateway --filter ./apps/web --filter ./apps/torqueshed-native typecheck"
  },
