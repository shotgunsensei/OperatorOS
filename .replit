modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5002
externalPort = 3002

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "scripts/start-unified-runtime.mjs"]
build = ["bash", "-c", "export CI=true && npm exec --yes --package=pnpm@10.34.5 -- pnpm install --frozen-lockfile && export INTERNAL_API_URL=http://localhost:5001 && export NODE_OPTIONS='--max-old-space-size=4096' && npm exec --yes --package=pnpm@10.34.5 -- pnpm build:production"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5001 tsx apps/api/src/index.ts & PORT=5002 tsx apps/runner-gateway/src/index.ts & sleep 2 && cd apps/web && INTERNAL_API_URL=http://localhost:5001 npx next dev -p 5000"
waitForPort = 5000

[userenv]

[userenv.production]
NODE_ENV = "production"
OPERATOROS_BASE_URL = "https://operatoros.net"
OPERATOROS_APPS_URL = "https://app.operatoros.net/"
STRIPE_MODE = "live"
APP_ENV = "production"
TRUST_PROXY = "true"
INTERNAL_API_URL = "http://localhost:5001"
OPERATOROS_DATABASE_RELEASE_MODE = "apply"
TRADEFLOWKIT_URL = "https://tradeflowkit.operatoros.net"
TORQUESHED_URL = "https://torqueshed.operatoros.net"
TECHDECK_URL = "https://techdeck.operatoros.net"
PULSEDESK_URL = "https://pulsedesk.operatoros.net"
FAULTLINELAB_URL = "https://faultlinelab.operatoros.net"
NINJA_POOL_HALL_URL = "https://ninja-pool-hall.operatoros.net"
BRANDFORGEOS_URL = "https://brandforgeos.operatoros.net"
SNAPPROOFOS_URL = "https://snapproofos.operatoros.net"
STUDYFORGE_AI_URL = "https://studyforge-ai.operatoros.net"
NINJA_LAUNCH_KIT_URL = "https://ninjalaunchkit.operatoros.net"
CALLCOMMAND_AI_URL = "https://callcommand-ai.operatoros.net"
TWILIO_PUBLIC_BASE_URL = "https://callcommand-ai.operatoros.net"
NINJAMATION_URL = "https://ninjamation.operatoros.net"
OUTCALL_URL = "https://outcall.operatoros.net"
# Host attachment only. OutCall remains catalog `coming_soon` / registry
# `planned` and cannot launch or be purchased until explicitly activated.

[userenv.development]
OPERATOROS_BOOTSTRAP_SUPER_ADMIN_EMAIL = "john@shotgunninjas.com"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[agent]
integrations = ["stripe:1.0.0"]
